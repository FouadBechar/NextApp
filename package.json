{
  "name": "NextApp",
  "version": "0.1.0",
  "author": "Fouad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FouadBechar/NextApp.git"
  },
  "scripts": {
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "postbuild": "node ./scripts/generate-sitemap.mjs",
    "sitemap": "node ./scripts/generate-sitemap.mjs",
    "sitemap:cli": "node ./cli/index.mjs",
    "start": "next start",
    "test:avatar:local": "node ./scripts/test-avatar-sharp.js",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test -p chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --headed --debug",
    "playwright-debug": "playwright test --headed --debug",
    "test:e2e:serve": "start-server-and-test 'npm run dev' http://localhost:3000 'npx playwright test'",
    "test:e2e:serve:debug": "start-server-and-test 'npm run dev' http://localhost:3000 'npx playwright test --headed --debug'",
    "backfill:dry": "node ./scripts/backfill-forum-avatars.mjs --dry-run",
    "backfill": "node ./scripts/backfill-forum-avatars.mjs",
    "backfill:profiles": "node ./scripts/backfill-forum-avatars.mjs --force"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-email/components": "^0.5.6",
    "@react-email/render": "^1.3.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.75.0",
    "@types/qrcode": "^1.5.6",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "ioredis": "^5.3.2",
    "lucide-react": "^0.546.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "ora": "^9.3.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-focus-lock": "^2.9.4",
    "react-hook-form": "^7.65.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.1.3",
    "sharp": "^0.32.0",
    "sitemap": "^8.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "typeit": "^8.8.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.4.1",
    "@playwright/test": "^1.41.0",
    "@tailwindcss/postcss": "^4.2.3",
    "@types/node": "^20",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10",
    "baseline-browser-mapping": "^2.9.19",
    "browserslist": "^4.22.0",
    "jsdom": "^29.0.2",
    "start-server-and-test": "^3.0.2",
    "supabase": "^2.93.0",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "last 2 versions",
      "not dead",
      "not IE 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  },
  "bin": {
    "next-sitemap-gen": "./cli/index.mjs"
  }
}
