# Local development env vars (do not commit secrets)
# Allowed origins for the dev server; comma-separated list.
# Example: ALLOWED_DEV_ORIGINS=http://localhost:3000,http://192.168.100.3:3000
ALLOWED_DEV_ORIGINS=http://localhost:3000

# Public site URL used when generating sitemap.xml during builds
NEXT_PUBLIC_SITE_URL=https://your-site.example

# Server-side chat configuration. The widget always calls the local /api/chat route.
OPENROUTER_API_KEY=your-openrouter-api-key
CHAT_DEFAULT_MODEL=openai/gpt-4o-mini

# Supabase configuration (add your project's values here for local builds)
# Get these values from your Supabase dashboard → Settings → API
# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=service_role_key_here
