# Example env file for local development
# ALLOWED_DEV_ORIGINS: comma-separated list of origins to allow in dev
# Example
ALLOWED_DEV_ORIGINS=http://localhost:3000
# Public site URL used for sitemap generation and canonical links
NEXT_PUBLIC_SITE_URL=https://your-site.example
# Server-side chat configuration. The widget always calls the local /api/chat route.
OPENROUTER_API_KEY=your-openrouter-api-key
CHAT_DEFAULT_MODEL=openai/gpt-4o-mini
# Redis connection string for shared rate limiting
REDIS_URL=redis://:password@localhost:6379
