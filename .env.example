# Example env file for local development
# ALLOWED_DEV_ORIGINS: comma-separated list of origins to allow in dev
# Example
ALLOWED_DEV_ORIGINS=http://localhost:3000
# Public site URL used for sitemap generation and canonical links
NEXT_PUBLIC_SITE_URL=https://your-site.example
# Show debug console.log in the ChatWidget (set to true to enable, only visible on client)
NEXT_PUBLIC_CHAT_DEBUG=true
# Public chat API endpoint used by the ChatWidget
NEXT_PUBLIC_CHAT_API_URL=https://chat-779e.onrender.com/chat
# Default model requested by the ChatWidget
NEXT_PUBLIC_CHAT_DEFAULT_MODEL=openai/gpt-4o-mini
# Optional warm-up request for cold-started chat backends
NEXT_PUBLIC_CHAT_WARMUP=false
# Redis connection string for shared rate limiting
REDIS_URL=redis://:password@localhost:6379
